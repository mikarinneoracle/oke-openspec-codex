# Copy this file to terraform.tfvars for local or Resource Manager-backed input.
# Do not commit terraform.tfvars.

region         = "eu-frankfurt-1"
compartment_id = "REPLACE_WITH_COMPARTMENT_OCID"

create_vcn                    = true
control_plane_is_public        = true
control_plane_allowed_cidrs    = ["REPLACE_WITH_ADMIN_PUBLIC_IP_CIDR"]
worker_nodes_in_private_subnet = true
pods_in_private_subnet         = true
gateway_load_balancer_is_public = true

# The initial managed system pool hosts Flux, Envoy Gateway, Crossplane, and
# Karpenter before workload capacity is provisioned dynamically.
system_node_count = 1
system_node_shape = "VM.Standard.E5.Flex"
system_node_ocpus = 1
system_node_memory_gb = 8

enable_karpenter = true

# Karpenter capacity is configured later in GitOps manifests. Keep manual
# static capacity and automatic dynamic capacity as separate NodePools.
